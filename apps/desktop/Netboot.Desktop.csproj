<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Bootah</AssemblyName><Product>Bootah</Product><ApplicationIcon>../../assets/branding/bootah.ico</ApplicationIcon>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0</TargetFramework>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="Avalonia.Desktop" Version="11.3.9"/><PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.9"/><PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3"/></ItemGroup>
  <ItemGroup><EmbeddedResource Include="../../LICENSES/third-party.json" LogicalName="Bootah.ThirdParty.json"/></ItemGroup>
  <ItemGroup><AvaloniaResource Include="../../assets/branding/bootah.ico" Link="Assets/bootah.ico"/></ItemGroup>
  <ItemGroup><Content Include="../../resources/system-icons/**/*.png" Link="system-icons/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest"/></ItemGroup>
  <ItemGroup><Compile Include="$(IntermediateOutputPath)Strings.g.cs"/></ItemGroup>
  <ItemGroup><Compile Include="$(IntermediateOutputPath)Version.g.cs"/></ItemGroup>
  <Target Name="GenerateVersion" BeforeTargets="CoreCompile">
    <Exec Command="python3 ../../scripts/generate_versions.py --platform desktop --runtime &quot;$(RuntimeIdentifier)$(OS)&quot; --output &quot;$(IntermediateOutputPath)Version.g.cs&quot;"/>
  </Target>
  <Target Name="GenerateI18n" BeforeTargets="CoreCompile" Inputs="../../i18n/terms.json;../../scripts/generate_i18n.py" Outputs="$(IntermediateOutputPath)Strings.g.cs">
    <Exec Command="python3 ../../scripts/generate_i18n.py --platform desktop --output &quot;$(IntermediateOutputPath)Strings.g.cs&quot;"/>
  </Target>
</Project>
